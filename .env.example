# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blog"

# Long random strings, different from each other. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""

PORT=3000

# Admin account created by `npm run seed` (optional; a random password is printed if unset)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
