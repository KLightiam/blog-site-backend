# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blog"

# Long random strings, different from each other. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""

PORT=3000

# Cloudinary, for cover images uploaded in the admin. Copy "API environment variable" from
# your Cloudinary dashboard (Settings > API Keys). Without it, everything works except uploads.
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
# Folder the images go into (optional)
CLOUDINARY_FOLDER="kabahs-blog"

# Only accept browser requests from these sites, comma-separated (optional; default allows any)
# CORS_ORIGIN="https://kabahs-blog.netlify.app"

# Admin account created by `npm run seed` (optional; a random password is printed if unset)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
